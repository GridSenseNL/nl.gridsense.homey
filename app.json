{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.gridsense.homey",
  "version": "1.0.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "GridSense"
  },
  "description": {
    "en": "Integrate GridSense Energy Management into your Homey ecosystem."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "GridSense B.V.",
    "email": "info@gridsense.nl"
  },
  "homepage": "https://gridsense.nl/",
  "drivers": [
    {
      "id": "gridsense-battery",
      "name": {
        "en": "GridSense Home Battery"
      },
      "class": "battery",
      "platforms": [
        "local"
      ],
      "driver": "drivers/gridsense-battery/driver.js",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "measure_power",
        "meter_power.imported",
        "meter_power.exported"
      ],
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.imported",
        "meterPowerExportedCapability": "meter_power.exported"
      }
    },
    {
      "id": "gridsense-evcharger",
      "name": {
        "en": "GridSense EV Charger"
      },
      "class": "evcharger",
      "platforms": [
        "local"
      ],
      "driver": "drivers/gridsense-evcharger/driver.js",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "evcharger_charging_state",
        "measure_power",
        "meter_power"
      ],
      "energy": {
        "evCharger": true,
        "meterPowerImportedCapability": "meter_power"
      },
      "capabilitiesOptions": {
        "meter_power.session": {
          "title": {
            "en": "Session energy"
          }
        }
      }
    },
    {
      "id": "gridsense-gateway",
      "name": {
        "en": "GridSense Gateway"
      },
      "class": "other",
      "driver": "drivers/gridsense-gateway/driver.js",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [],
      "discovery": "gridsense-gateway"
    },
    {
      "id": "gridsense-gridmeter",
      "name": {
        "en": "GridSense Export+Import Meter"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "driver": "drivers/gridsense-gridmeter/driver.js",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "measure_power",
        "meter_power.imported",
        "meter_power.exported"
      ],
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power.imported",
        "cumulativeExportedCapability": "meter_power.exported"
      }
    },
    {
      "id": "gridsense-inverter",
      "name": {
        "en": "GridSense Inverter"
      },
      "class": "solarpanel",
      "platforms": [
        "local"
      ],
      "driver": "drivers/gridsense-inverter/driver.js",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "measure_power",
        "meter_power"
      ],
      "energy": {
        "meterPowerExportedCapability": "meter_power"
      }
    }
  ],
  "discovery": {
    "gridsense-gateway": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "gridsense-homey",
        "protocol": "tcp"
      },
      "id": "{{txt.uuid}}"
    }
  }
}